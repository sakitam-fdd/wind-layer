{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:minify": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test-only": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "coverage": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "api": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
