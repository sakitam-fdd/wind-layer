{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev --filter='./packages/*'",
    "build": "turbo run build --filter='./packages/*'",
    "build:minify": "turbo run build:minify --filter='./packages/*'",
    "playground": "turbo run dev --filter=playground",
    "docs": "pnpm run docs:dev",
    "api": "turbo run api --filter='./packages/*'",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:serve": "pnpm --filter docs run serve ",
    "version": "changeset version",
    "changeset": "changeset",
    "clean": "turbo run clean --filter='./packages/*'",
    "clear": "pnpm run clean",
    "release": "pnpm build && pnpm build:minify && changeset publish",
    "lint": "turbo run lint --filter='./packages/*'",
    "prettier": "prettier --parser=typescript --write **/*.{js,ts,md}",
    "test": "turbo run test --filter='./packages/*'",
    "test-only": "turbo run test-only --filter='./packages/*'",
    "coverage": "turbo run coverage --filter='./packages/*'"
  },
  "devDependencies": {
    "@aurorafe/eslint-config-base": "^1.1.0",
    "@aurorafe/eslint-config-ts": "^1.1.0",
    "@aurorafe/eslint-config-vue": "^1.1.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.19.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-eslint": "^9.2.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^28.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "terser": "^5.51.2",
    "typescript": "~5.4.5",
    "typedoc": "^0.25.12",
    "typedoc-plugin-markdown": "^3.17.1",
    "typedoc-plugin-not-exported": "^0.1.6",
    "vue": "^3.5.45",
    "vitest": "^4.1.12",
    "vite": "^6.4.1",
    "vitepress": "^1.6.4",
    "wait-for-expect": "3.0.2",
    "lint-staged": "^13.0.3",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.6",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-glslify": "^1.3.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "rollup-plugin-sourcemaps": "^0.6.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint",
      "pre-push": "pnpm run test"
    }
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "git add"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write",
      "git add"
    ]
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "canvas"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "rollup": "4"
      }
    },
    "overrides": {
      "handlebars": ">=4.7.10",
      "flatted": ">=3.4.2",
      "brace-expansion": ">=2.1.5"
    }
  }
}
